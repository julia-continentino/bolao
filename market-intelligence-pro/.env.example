# Banco de dados PostgreSQL (ou string de conexão do Supabase)
DATABASE_URL="postgresql://mip:mip@localhost:5432/mip"

# Segredo para assinar sessões (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Integração de IA (Anthropic Claude) — obrigatória para executar pesquisas
ANTHROPIC_API_KEY=""
# Modelo e esforço de raciocínio dos agentes
AI_MODEL="claude-opus-5-5"
AI_EFFORT="high"
# Máximo de buscas web por agente
AI_MAX_SEARCHES_PER_AGENT="10"

# SEC EDGAR exige um User-Agent com nome e e-mail de contato
# (https://www.sec.gov/os/accessing-edgar-data). Deixe vazio para desativar.
SEC_USER_AGENT=""
